+
+/* Reconciliacion despues de cargar un estado guardado.
+ *
+ * `RtlLoadSnapshot` restaura el blob del SNES, pero el estado de ejecucion del lado del HOST no
+ * cabe ahi, y el runner deja este hook para rebuscarlo contra la WRAM recien restaurada. Sin el,
+ * el estado se cargaba y el juego aparecia en la introduccion: `g_cpu.ram` seguia apuntando a
+ * donde apuntara antes. Es el equivalente de `Dkc1OnStateLoaded`, que es por lo que la
+ * suspension de los Donkey Kong Country si funcionaba. */
+static void SmOnStateLoaded(uint32_t version) {
+  (void)version;
+  g_cpu.ram = g_ram;
+  g_apu_last_sync_master = g_cpu.master_cycles;
+  interp_bridge_set_master_deadline(0);
+  /* `beamMasterLast` lo pone ya RtlLoadSnapshot justo antes de llamarnos; aqui `Snes` es un tipo
+   * opaco y tocarlo no compila. */
+}
