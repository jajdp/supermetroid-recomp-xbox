+/* Volcado de la RAM del invitado, cuadro a cuadro elegido (ver SM_RAM_DUMP en
+   el bucle principal). Sirve para comparar byte a byte dos builds del MISMO
+   arbol compilados con compiladores distintos. */
+#define SM_RAM_DUMP_MAX 16
+static void SmDumpGuestRam(const char *prefix, unsigned frame) {
+  char path[1024];
+  snprintf(path, sizeof(path), "%s-f%u.bin", prefix, frame);
+  FILE *f = fopen(path, "wb");
+  if (!f) {
+    fprintf(stderr, "[sm_ram_dump] no se pudo abrir %s\n", path);
+    return;
+  }
+  fwrite(g_ram, 1, 0x20000, f);
+  fclose(f);
+  fprintf(stderr, "[sm_ram_dump] cuadro %u -> %s (crc=%08x)\n",
+          frame, path, crc32_compute(g_ram, 0x20000));
+}
