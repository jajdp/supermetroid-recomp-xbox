+#ifdef SM_UWP
+/* Volver donde lo dejaste (Recompilaciones, 2026-10-06).
+ *
+ * En Dev Mode la Xbox NO suspende los juegos: los TERMINA en cuanto pasan al fondo
+ * y al volver se relanzan desde cero. El motor sabe serializar la máquina entera
+ * (el mismo formato de los estados guardados), así que se escribe uno cada diez
+ * segundos y se vuelve a cargar al arrancar.
+ *
+ * Cada 10 s y no en el aviso de suspensión: cuando ese aviso llega puede que ya no
+ * se emule un cuadro más (medido en Street Fighter EX2 Plus), y el estado solo es
+ * coherente en un borde de cuadro.
+ *
+ * El archivo se aparta antes de cargarlo y se borra después: si un estado corrupto
+ * colgara el juego al restaurarlo, el arranque siguiente ya no lo encuentra y el
+ * juego entra limpio en vez de quedarse inservible.
+ *
+ * La ruta es relativa porque el directorio de trabajo ya es la carpeta de datos de
+ * la app (uwp_entry.cpp). */
+#define SM_ESTADO           "suspension.state"
+#define SM_ESTADO_CARGANDO  "suspension.state.cargando"
+
+static double s_sm_t_estado = 0.0;
+
+/* Estado de otra version: un estado escrito por OTRO binario deja la máquina emulada
+ * inconsistente y el juego sale con los gráficos rotos (le pasó al usuario en Super Mario World
+ * el 2026-10-06). La marca es la ruta del ejecutable, que cambia en cada instalación; la fecha
+ * de compilación NO vale, porque solo cambia si se recompila ESTE archivo. */
+#define SM_ESTADO_MARCA "suspension.marca"
+
+static bool SmEstadoEsDeOtraVersion(void) {
+  char propio[512] = { 0 }, leido[512] = { 0 };
+  FILE *f;
+  GetModuleFileNameA(NULL, propio, (unsigned long)(sizeof propio - 1));
+  f = fopen(SM_ESTADO_MARCA, "rb");
+  if (f) {
+    size_t n = fread(leido, 1, sizeof leido - 1, f);
+    leido[n] = 0;
+    fclose(f);
+  }
+  if (strcmp(leido, propio) == 0) return false;
+  if (leido[0]) {
+    fprintf(stderr, "suspension: el estado es de otra version, se descarta\n");
+    fflush(stderr);
+  }
+  f = fopen(SM_ESTADO_MARCA, "wb");
+  if (f) { fwrite(propio, 1, strlen(propio), f); fclose(f); }
+  return true;
+}
+
+static void SmRestauraEstado(void) {
+  if (SmEstadoEsDeOtraVersion()) {
+    remove(SM_ESTADO);
+    return;
+  }
+  remove(SM_ESTADO_CARGANDO);
+  if (rename(SM_ESTADO, SM_ESTADO_CARGANDO) != 0) {
+    fprintf(stderr, "suspension: no hay estado guardado, arranque normal\n");
+    return;
+  }
+  bool ok = RtlLoadSnapshot(SM_ESTADO_CARGANDO);
+  remove(SM_ESTADO_CARGANDO);
+  fprintf(stderr, ok ? "suspension: estado restaurado, sigue la partida\n"
+                     : "suspension: el estado no se pudo cargar, se empieza de cero\n");
+  fflush(stderr);
+}
+
+static void SmGuardaEstado(void) {
+  SmEstadoEsDeOtraVersion();   /* deja la marca de ESTE binario junto al estado */
+  if (!RtlSaveSnapshot(SM_ESTADO)) {
+    fprintf(stderr, "suspension: NO se pudo guardar el estado\n");
+    fflush(stderr);
+  }
+}
+#endif
